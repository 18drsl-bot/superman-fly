-- Superman Fly v2 (minimized, CoreGui + MainCore, re-execute safe)
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local WS = game:GetService("Workspace")

-- Unload previous instance if it exists
local UNLOAD_KEY = "__SupermanFlyV2_Unload"
if _G[UNLOAD_KEY] then
    pcall(_G[UNLOAD_KEY])
    _G[UNLOAD_KEY] = nil
end

local plr = Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local hrp = char:WaitForChild("HumanoidRootPart")
local origGrav = WS.Gravity

local flying, boosting, waiting = false, false, false
local speed = 50
local toggleKey = Enum.KeyCode.X
local move = {f=0, b=0, l=0, r=0}
local curCF, curVel = nil, Vector3.new()
local lerpC = 0.1
local bobFreq, bobAmp = 1, 0.5
local fConns, gConns = {}, {}
local animTrack
local closed = false

local function setNoclip(on)
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = not on end
    end
end

local function playAnim(id, t, sp)
    if animTrack then animTrack:Stop(0.1); animTrack = nil end
    local an = char:FindFirstChild("Animate"); if an then an.Disabled = true end
    for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do tr:Stop() end
    local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://"..id
    animTrack = hum:LoadAnimation(a); animTrack:Play()
    animTrack.TimePosition = t; animTrack:AdjustSpeed(sp)
end

local function stopAnim()
    if animTrack then animTrack:Stop(0.1); animTrack = nil end
    local an = char:FindFirstChild("Animate"); if an then an.Disabled = false end
    for _, tr in ipairs(hum:GetPlayingAnimationTracks()) do tr:Stop() end
end

local function new(c, p, par)
    local o = Instance.new(c)
    for k, v in pairs(p) do o[k] = v end
    o.Parent = par
    return o
end

