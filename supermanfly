--------------------------------------------------
-- Drag
--------------------------------------------------
local dragging, dragPos, dragStart
mainCore.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true; dragPos = mainCore.Position; dragStart = i.Position
    end
end)
mainCore.InputChanged:Connect(function(i)
    if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = i.Position - dragStart
        mainCore.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset+d.X, dragPos.Y.Scale, dragPos.Y.Offset+d.Y)
    end
end)
local dragEndConn = UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
table.insert(gConns, dragEndConn)

--------------------------------------------------
-- Speed & Keybind UI
--------------------------------------------------
speedBox.FocusLost:Connect(function()
    local n = tonumber(speedBox.Text)
    if n then speed = n else speedBox.Text = tostring(speed) end
end)
plusBtn.MouseButton1Click:Connect(function() speed = speed + 5; speedBox.Text = tostring(speed) end)
minusBtn.MouseButton1Click:Connect(function() speed = math.max(0, speed - 5); speedBox.Text = tostring(speed) end)
keyBtn.MouseButton1Click:Connect(function()
    waiting = true; keyBtn.Text = "PRESS ANY KEY..."; keyBtn.BackgroundColor3 = Color3.fromRGB(75,255,75)
end)

--------------------------------------------------
-- Boost (Left click)
--------------------------------------------------
table.insert(gConns, UIS.InputBegan:Connect(function(i, gp)
    if gp then return end
    if i.UserInputType == Enum.UserInputType.MouseButton1 and flying and not boosting then
        boosting = true; speed = speed * 1.3; speedBox.Text = tostring(speed)
    end
end))
table.insert(gConns, UIS.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 and boosting then
        speed = speed / 1.3; speedBox.Text = tostring(speed); boosting = false
    end
end))

--------------------------------------------------
-- Flight Start / Stop
--------------------------------------------------
local function stopFlight()
    flying = false
    toggleBtn.Text = "FLY: OFF"
    TS:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3=Color3.fromRGB(255,40,100)}):Play()
    WS.Gravity = origGrav
    hum.PlatformStand = false
    setNoclip(false)
    stopAnim()
    if hrp:FindFirstChild("FlyGyro") then hrp.FlyGyro:Destroy() end
    if hrp:FindFirstChild("FlyVelocity") then hrp.FlyVelocity:Destroy() end
    for _, c in ipairs(fConns) do if c.Connected then c:Disconnect() end end
    fConns = {}
    move = {f=0, b=0, l=0, r=0}
    if boosting then speed = speed / 1.3; speedBox.Text = tostring(speed); boosting = false end
end

local function startFlight()
    flying = true
    toggleBtn.Text = "FLY: ON"
    TS:Create(toggleBtn, TweenInfo.new(0.3), {BackgroundColor3=Color3.fromRGB(75,255,75)}):Play()
    WS.Gravity = 0
    hum.PlatformStand = true
    setNoclip(true)
    playAnim(10714347256, 4, 0)

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "FlyGyro"; gyro.Parent = hrp
    gyro.P = 90000; gyro.MaxTorque = Vector3.new(9e9,9e9,9e9); gyro.CFrame = hrp.CFrame

    local bv = Instance.new("BodyVelocity")
    bv.Name = "FlyVelocity"; bv.Parent = hrp
    bv.MaxForce = Vector3.new(9e9,9e9,9e9); bv.Velocity = Vector3.new(0,0.1,0)

    curVel = Vector3.new()

    table.insert(fConns, RS.RenderStepped:Connect(function()
        local cam = WS.CurrentCamera
        setNoclip(true)
        local f = move.f - move.b
        local s = move.r - move.l
        local iv = (cam.CFrame.LookVector * f) + (cam.CFrame.RightVector * s)
        if f ~= 0 then iv = iv + Vector3.new(0, 0.2*f, 0) end
        local bob = math.sin(tick() * bobFreq) * bobAmp
        local dv = iv.Magnitude > 0 and iv.Unit * speed or Vector3.new(0, bob, 0)
        curVel = curVel:Lerp(dv, 0.1)
        bv.Velocity = curVel
        local dcf = f > 0 and cam.CFrame * CFrame.Angles(math.rad(-90), 0, 0)
                         or cam.CFrame * CFrame.Angles(math.rad(-45*f), 0, 0)
        curCF = curCF and curCF:Lerp(dcf, lerpC) or dcf
        gyro.CFrame = curCF
    end))

    local function onBegan(i, gp)
        if gp or i.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local k = i.KeyCode
        if k == Enum.KeyCode.W then move.f = 1; playAnim(10714177846, 4.65, 0)
        elseif k == Enum.KeyCode.S then move.b = 1; playAnim(10714347256, 4, 0)
        elseif k == Enum.KeyCode.A then move.l = 1; if move.f > 0 then playAnim(10714177846, 4.65, 0) end
        elseif k == Enum.KeyCode.D then move.r = 1; if move.f > 0 then playAnim(10714177846, 4.65, 0) end
        end
    end
    local function onEnded(i)
        if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
        local k = i.KeyCode
        if k == Enum.KeyCode.W then move.f = 0; playAnim(10714347256, 4, 0)
        elseif k == Enum.KeyCode.S then move.b = 0; playAnim(10714347256, 4, 0)
        elseif k == Enum.KeyCode.A then move.l = 0; if move.f > 0 then playAnim(10714177846, 4.65, 0) end
        elseif k == Enum.KeyCode.D then move.r = 0; if move.f > 0 then playAnim(10714177846, 4.65, 0) end
        end
    end
    table.insert(fConns, UIS.InputBegan:Connect(onBegan))
    table.insert(fConns, UIS.InputEnded:Connect(onEnded))
end

local function toggleFlight()
    if flying then stopFlight() else startFlight() end
end

--------------------------------------------------
-- Global keybind handler
--------------------------------------------------
local ignoredKeys = {Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl,
    Enum.KeyCode.LeftAlt, Enum.KeyCode.RightAlt, Enum.KeyCode.LeftSuper, Enum.KeyCode.RightSuper, Enum.KeyCode.Unknown}

table.insert(gConns, UIS.InputBegan:Connect(function(i, gp)
    if gp or i.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if waiting then
        for _, k in ipairs(ignoredKeys) do if i.KeyCode == k then return end end
        waiting = false; toggleKey = i.KeyCode
        keyBtn.Text = "KEYBIND: "..toggleKey.Name
        keyBtn.BackgroundColor3 = Color3.fromRGB(25,25,40)
    elseif i.KeyCode == toggleKey then
        toggleFlight()
    end
end))

toggleBtn.MouseButton1Click:Connect(toggleFlight)

--------------------------------------------------
-- Character respawn
--------------------------------------------------
local charConn = plr.CharacterAdded:Connect(function(nc)
    char = nc
    hum = nc:WaitForChild("Humanoid")
    hrp = nc:WaitForChild("HumanoidRootPart")
    if flying then stopFlight() end
end)
table.insert(gConns, charConn)

--------------------------------------------------
-- Cleanup (shared by Close button + re-execute unload)
--------------------------------------------------
local function cleanup()
    if closed then return end
    closed = true
    if flying then stopFlight() end
    for _, c in ipairs(gConns) do if c.Connected then c:Disconnect() end end
    for _, c in ipairs(fConns) do if c.Connected then c:Disconnect() end end
    fConns, gConns = {}, {}
    if gui then gui:Destroy() end
    if _G[UNLOAD_KEY] == cleanup then _G[UNLOAD_KEY] = nil end
end

_G[UNLOAD_KEY] = cleanup

closeBtn.MouseButton1Click:Connect(function()
    cleanup()
    pcall(function() script:Destroy() end)
end)
