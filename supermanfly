local function onMouseInputBegan(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if isFlying and not isBoosting then
            isBoosting = true
            flightSpeed = flightSpeed * 1.3
            speedTextBox.Text = tostring(flightSpeed)
        end
    end
end

local function onMouseInputEnded(input, gameProcessed)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        if isBoosting then
            flightSpeed = flightSpeed / 1.3
            speedTextBox.Text = tostring(flightSpeed)
            isBoosting = false
        end
    end
end

